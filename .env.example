# ── Integrações externas ─────────────────────────────────────────────────────
# Sem estas chaves o sistema opera em MODO DEMONSTRAÇÃO (dados de mockData).

# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# IsThereAnyDeal API key — https://isthereanydeal.com/dev/app/
ITAD_API_KEY=

# ── Observabilidade ──────────────────────────────────────────────────────────
# Nível mínimo de log: debug | info | warn | error | silent  (default: info)
LOG_LEVEL=info

# ── Persistência (Postgres, sem ORM — driver pg) ─────────────────────────────
# Usado a partir da slice de persistência. Em dev, suba via docker-compose.
DATABASE_URL=postgres://gpt:gpt@localhost:5432/gamepricetracker

# ── Autenticação (Steam OpenID + sessão) ─────────────────────────────────────
# Segredo HMAC para assinar o cookie de sessão. OBRIGATÓRIO em produção
# (gere um valor forte: `openssl rand -base64 32`). Sem DATABASE_URL, os usuários
# ficam em memória (apenas demonstração).
SESSION_SECRET=

# Origin público da app (realm/return_to do OpenID). Opcional: por padrão usa o
# origin da requisição. Defina atrás de proxy/HTTPS, ex.: https://meusite.com
APP_URL=

# ── Jobs de sincronização (node-cron) ────────────────────────────────────────
# Liga o agendador interno de sincronização de preços no startup do servidor.
ENABLE_PRICE_SYNC=false
# Expressão cron da sincronização (default: de hora em hora).
SYNC_CRON=0 * * * *
# Se definido, exige o header `x-cron-secret` em POST /api/jobs/sync.
CRON_SECRET=
